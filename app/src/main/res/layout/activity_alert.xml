<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/alertRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alert_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/alertIcon"
            android:layout_width="180dp"
            android:layout_height="176dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/alertTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:text="@string/alert_screen_title"
            android:textColor="#FFF177"
            android:textSize="34sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#44515B"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/alertMessageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_alert_message_card"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:padding="20dp"
                android:textColor="#F5F7FA"
                android:textSize="18sp" />
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/stopAlertButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#FF6C5A"
            android:text="@string/stop_alarm_button" />
    </LinearLayout>
</FrameLayout>
