<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ruleSampleLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/add_rule_sample_hint"
            app:helperText="@string/add_rule_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ruleSampleInput"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="5" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/extractTagsButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="@string/extract_tags_button"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/tagHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tag_hint_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tagSelectionHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tag_selection_hint_text"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.example.parkingalert.widget.MaxHeightNestedScrollView
            android:id="@+id/tagScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/candidateContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.example.parkingalert.widget.MaxHeightNestedScrollView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
