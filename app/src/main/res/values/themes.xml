<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ParkingAlert" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/signal_teal</item>
        <item name="colorPrimaryVariant">@color/signal_teal_dark</item>
        <item name="colorOnPrimary">#061412</item>
        <item name="colorSecondary">@color/signal_alert</item>
        <item name="colorOnSecondary">#FFF8F6</item>
        <item name="colorSurface">@color/panel_surface</item>
        <item name="colorOnSurface">#F5F7FA</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/app_shell</item>
    </style>

    <style name="ThemeOverlay.ParkingAlert.RuleDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ParkingAlert.RuleDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ParkingAlert.RuleDialogButton</item>
    </style>

    <style name="Widget.ParkingAlert.RuleDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:minHeight">@dimen/rule_dialog_button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
    </style>
</resources>
